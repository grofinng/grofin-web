PORT=8080
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
BLOB_READ_WRITE_TOKEN=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_SURNAME=

# Server-side EmailJS (repayment reminders). Same service/public key as the
# client; the private key is under Account > API Keys in EmailJS.
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# One template for all repayment reminders (due soon, due today, overdue).
EMAILJS_TEMPLATE_REMINDER=
# Optional: a separate template for overdue notices. Falls back to the one above.
# EMAILJS_TEMPLATE_OVERDUE=
ESENA_EMAIL=grofinng@gmail.com

# Reminder schedule: warn this many days before the due date (comma list),
# on the due date, then every N days after it until marked repaid.
REPAYMENT_REMINDER_DAYS_BEFORE=2
REPAYMENT_OVERDUE_REMINDER_INTERVAL_DAYS=3
# Vercel Cron sends this as a bearer token to /api/jobs/repayment-reminders.
CRON_SECRET=
